# Smart Electricity Management System - Backend API

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sems_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Security
JWT_SECRET=sems_super_secret_key_change_in_production_2026
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=sems_refresh_secret_key_change_in_production_2026
JWT_REFRESH_EXPIRES_IN=7d

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
