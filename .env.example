# -----------------------------------------------------------------------------
# Smart Electricity Management System (SEMS) - Environment Variables Template
# -----------------------------------------------------------------------------

# Database (PostgreSQL) Configuration
DB_USER=postgres
DB_PASSWORD=your_highly_secure_db_password_here
DB_NAME=sems_db

# Security & Authentication (Node.js Backend)
JWT_SECRET=your_jwt_secret_token_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_token_here
GF_SECURITY_ADMIN_PASSWORD=your_grafana_dashboard_admin_password_here

# AI Service Configuration
AI_API_KEY=your_ai_service_api_key_here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
MOCK_AI=True
